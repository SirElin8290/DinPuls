{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dinpuls-push",
  "main": "cloudflare/push-worker.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dinpuls-push-db",
      "database_id": "2745e92f-51a3-448d-9a49-eb1a89a076c0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AD_ASSETS",
      "bucket_name": "dinpuls-ad-assets"
    }
  ]
}
